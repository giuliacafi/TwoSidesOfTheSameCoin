#load datasets
data <- read_excel("C:\\Users\\cafie001\\Downloads\\EnSa review\\Review R project\\data\\Database-EnSa review-10112026.xlsx")
# Convert the data into long format
library(tidyr)
data_long <- data %>%
pivot_longer(cols = c(res_man, ecotox, beneficial),
names_to = "Category",
values_to = "Value") %>%
filter(Value == "x") # Only keep rows where the value is "x"
data_long_colors <- data_long %>%
mutate(
red = case_when(
Category == "res_man"    ~ 87,
Category == "ecotox"     ~ 169,
Category == "beneficial" ~ 240,
TRUE ~ NA_real_
),
green = case_when(
Category == "res_man"    ~ 100,
Category == "ecotox"     ~ 59,
Category == "beneficial" ~ 228,
TRUE ~ NA_real_
),
blue = case_when(
Category == "res_man"    ~ 174,
Category == "ecotox"     ~ 150,
Category == "beneficial" ~ 66,
TRUE ~ NA_real_
)
)
library(readr)
map_data <- read_tsv(
"author_map.txt",
col_names = TRUE,
comment = "#"
)
map_data <- read_tsv(
"category networks based on first authorp.txt",
col_names = TRUE,
comment = "#"
)
map_data <- read_tsv(
"category networks based on first author.txt",
col_names = TRUE,
comment = "#"
)
map_data <- read_tsv(
"category networks based on first author.txt",
col_names = TRUE,
comment = "#"
)
map_data <- map_data %>%
mutate(
DOI = sub("^.*doi\\.org/", "", url)
)
map_data <- read_tsv(
"author_map.txt",
col_names = TRUE,
comment = "#"
)
map_data <- map_data %>%
mutate(
DOI = sub("^.*doi\\.org/", "", url)
)
map_data_merged <- map_data %>%
left_join(
data_long_colors,
by = "DOI"
)
table(map_data_merged$Category, useNA = "ifany")
na_table <- map_data_merged %>%
dplyr::filter(is.na(Category))
merge_NA <- data_long_colors %>%
left_join(
map_data_merged,
by = "DOI"
)
map_data_merged %>%
count(Category, red, green, blue)
map_final <- map_data_merged %>%
dplyr::select(
id,
label,
x,
y,
red,
green,
blue)
write.table(
map_final,
"VOSviewer_custom_colors.map",
sep = "\t",
row.names = FALSE,
quote = FALSE,
na = ""
)
head(map_final)
# Plot ADME
adme_counts <- data_long %>%
group_by(Category, ADME) %>%
summarise(n = n(), .groups = "drop")
# Define colors
adme_colors <- c(
"Absorption" = "#56B4E9",
"Distribution" = "#D55E00",
"Metabolism" = "#009E73",
"Excretion" = "#F0E442",
"Bioaccumulation" = "#CC79A7"
)
# Grouped bar plot
ADME_plot <- ggplot(adme_counts, aes(x = Category, y = n, fill = ADME)) +
geom_col(
position = position_dodge(width = 0.8),
width = 0.7,
color = "white"
) +
scale_fill_manual(values = adme_colors) +
labs(
x = "Category",
y = "Number of studies",
fill = "ADME Process"
) +
theme_minimal() +
theme(axis.text.x = element_text(size = 16),
axis.text.y = element_text(size = 10),
legend.position = "bottom"
)
ggsave("C:\\Users\\cafie001\\Downloads\\EnSa review\\Review R project\\ADME_plot.pdf", plot = ADME_plot, width = 7, height = 5)
